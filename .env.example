# Plantilla de variables. Copia cada bloque al archivo indicado. NUNCA pongas claves reales en este archivo.

# ---- apps/api/.dev.vars (API) ----
# En produccion estos valores se cargan en el dashboard de Cloudflare, no en Git.
DATABASE_URL=pega_aqui_tu_cadena_de_conexion_de_neon
CLERK_SECRET_KEY=pega_aqui_tu_clave_secreta_de_clerk
CLERK_PUBLISHABLE_KEY=pega_aqui_tu_clave_publica_de_clerk
TURNSTILE_SECRET_KEY=pega_aqui_tu_clave_secreta_de_turnstile
ALLOWED_ORIGIN=http://localhost:5174
CLINIC_TIMEZONE=America/La_Paz

# ---- apps/panel/.env (panel) ----
VITE_CLERK_PUBLISHABLE_KEY=pega_aqui_tu_clave_publica_de_clerk

# ---- apps/web/.env (sitio publico) ----
PUBLIC_SHOW_PENDING=true
PUBLIC_API_URL=http://localhost:8787
PUBLIC_TURNSTILE_SITE_KEY=pega_aqui_tu_site_key_de_turnstile