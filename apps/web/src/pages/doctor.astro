---
import { Image } from "astro:assets";
import { Award, Building2, CalendarCheck, GraduationCap } from "lucide-react";
import { CLINIC } from "@dr-vargas/shared";
import doctorPhoto from "../assets/doctor-provisional.jpg";
import ContactSection from "../components/ContactSection.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import Sample from "../components/Sample.astro";
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const blocks = [
  { icon: GraduationCap, title: "Formación", lines: ["[Universidad, ciudad, año]", "[Especialidad, institución, año]", "[Subespecialidad, institución, año]"] },
  { icon: Building2, title: "Trayectoria", lines: ["[Hospital o clínica, años]", "[Cargo o área de trabajo]"] },
  { icon: Award, title: "Sociedades médicas", lines: ["[Sociedad o colegio, país]", "[Sociedad o colegio, país]"] },
];
---

<Base
  title="El doctor"
  description="Dr. Rolando Vargas Calvetty, ginecólogo oncólogo y mastólogo en Cochabamba, Bolivia."
  path="/doctor"
>
  <section class="py-12 md:py-20">
    <div class="container-page grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-start">
      <div class="mx-auto w-full max-w-sm md:max-w-none">
        <!-- FOTO PROVISIONAL: reemplazar por el retrato profesional (src/assets/doctor-provisional.jpg). -->
        <Image src={doctorPhoto} alt="Retrato del Dr. Rolando Vargas Calvetty" width={640} class="aspect-[4/5] w-full rounded-[var(--radius-card)] object-cover object-[50%_20%] shadow-[var(--shadow-soft)]" />
      </div>
      <div>
        <p class="eyebrow">El doctor</p>
        <h1 class="mt-3 text-4xl sm:text-5xl">Rolando Vargas Calvetty</h1>
        <p class="mt-3 font-display text-xl text-teal-700">{CLINIC.specialties.join(" · ")}</p>
        <p class="mt-6 text-lg text-ink-soft">
          El Dr. Vargas atiende en su consultorio de Cochabamba, en el Edificio V&amp;V NUR, junto al Parque Fidel Anze.
        </p>

        <Sample label="Biografía de ejemplo. El doctor redacta o aprueba el texto real y sus credenciales.">
          <p>
            [Presentación breve del doctor: cómo entiende la atención de sus pacientes y qué puede esperar una persona que llega por primera vez al consultorio.]
          </p>
          <p class="mt-3">
            [Segundo párrafo opcional: especialidades, áreas de mayor experiencia y forma de trabajo, solo con datos que el doctor confirme.]
          </p>
        </Sample>

        <Sample label="Formación y trayectoria de ejemplo. Solo se publica lo que el doctor confirme con sus documentos.">
          <div class="grid gap-4 sm:grid-cols-3">
            {
              blocks.map((b) => (
                <div>
                  <b.icon aria-hidden="true" size={24} class="text-teal-700" />
                  <h2 class="mt-2 text-lg">{b.title}</h2>
                  <ul class="mt-2 space-y-1 text-sm">
                    {b.lines.map((l) => <li>{l}</li>)}
                  </ul>
                </div>
              ))
            }
          </div>
        </Sample>

        <div class="mt-8">
          <a href={`${base}/cita`} class="btn btn-primary"><CalendarCheck aria-hidden="true" size={20} /> Solicitar cita</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-teal-50 py-12 md:py-20" aria-labelledby="consultorio">
    <div class="container-page">
      <p class="eyebrow">El consultorio</p>
      <h2 id="consultorio" class="mt-3 text-3xl sm:text-4xl">Un espacio pensado para tu comodidad</h2>
      <Sample label="Galería de ejemplo. Se reemplaza por fotos reales y autorizadas del consultorio. Sin pacientes identificables.">
        <div class="grid gap-4 sm:grid-cols-3">
          <PhotoPlaceholder label="Fachada y entrada" hint="Edificio V&V NUR" />
          <PhotoPlaceholder label="Sala de espera" hint="Foto pendiente" />
          <PhotoPlaceholder label="Consultorio" hint="Foto pendiente" />
        </div>
      </Sample>
    </div>
  </section>
  <ContactSection />
</Base>
