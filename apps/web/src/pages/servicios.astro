---
import { Image } from "astro:assets";
import CtaBand from "../components/CtaBand.astro";
import ServiceGroups from "../components/ServiceGroups.astro";
import logoLight from "../assets/logo-light.png";
import Base from "../layouts/Base.astro";
import { SERVICE_GROUPS } from "../data/services";
---

<Base
  title="Servicios de ginecología, oncología y mastología"
  description="Servicios del consultorio del Dr. Rolando Vargas Calvetty en Cochabamba: ginecología y obstetricia, oncología y mastología."
  path="/servicios"
>
  <section class="on-dark relative isolate overflow-hidden bg-teal-900 text-teal-50">
    <Image src={logoLight} alt="" aria-hidden="true" width={700} class="float-slow pointer-events-none absolute -right-16 -top-10 -z-10 w-[26rem] max-w-none opacity-[0.07]" loading="eager" />
    <div class="blob -left-20 top-0 h-64 w-64 bg-teal-600/30"></div>
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow rise !text-teal-300">Servicios</p>
      <h1 style="--d: 80ms" class="rise mt-3 max-w-3xl text-4xl !text-white sm:text-5xl">Servicios del consultorio</h1>
      <p style="--d: 160ms" class="rise mt-4 max-w-2xl text-lg text-teal-100">
        Ginecología, oncología y mastología en un mismo lugar. Esta información es orientativa y no reemplaza una evaluación médica individual.
      </p>
      <ul style="--d: 240ms" class="rise mt-8 flex flex-wrap gap-3" aria-label="Ir a una especialidad">
        {
          SERVICE_GROUPS.map((g) => (
            <li>
              <a href={`#${g.id}`} class="inline-flex min-h-11 items-center rounded-full border border-teal-300/40 bg-white/5 px-5 font-semibold text-white transition-colors hover:bg-white/15">
                {g.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <svg class="absolute bottom-0 left-0 h-8 w-full text-cream" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true"><path d="M0 48V28C240 4 480 2 720 18s480 26 720 6v24z" fill="currentColor"></path></svg>
  </section>

  <section class="bg-dots relative isolate overflow-hidden py-12 md:py-16">
    <div class="blob -right-24 top-20 h-80 w-80 bg-teal-200/50"></div>
    <div class="container-page">
      <ServiceGroups />
    </div>
  </section>
  <CtaBand />
</Base>
