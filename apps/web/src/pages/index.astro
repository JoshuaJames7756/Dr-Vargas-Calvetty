---
import { Image } from "astro:assets";
import { CalendarCheck, Clock, MapPin, MessageCircle, Phone, ListChecks, Check } from "lucide-react";
import { CLINIC, whatsappLink } from "@dr-vargas/shared";
import doctorPhoto from "../assets/doctor-provisional.jpg";
import logoLight from "../assets/logo-light.png";
import Pending from "../components/Pending.astro";
import Base from "../layouts/Base.astro";
import { SERVICE_GROUPS } from "../data/services";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${CLINIC.address.line1}, ${CLINIC.address.city}`,
)}`;

const steps = [
  { icon: ListChecks, title: "Elige el servicio", text: "Selecciona el motivo de tu consulta entre los servicios disponibles." },
  { icon: CalendarCheck, title: "Escoge un horario", text: "Verás solo los horarios que realmente están libres en la agenda." },
  { icon: MessageCircle, title: "Recibe la confirmación", text: "El consultorio revisa tu solicitud y te confirma por WhatsApp." },
];
---

<Base
  title="Ginecólogo Oncólogo y Mastólogo en Cochabamba"
  description="Dr. Rolando Vargas Calvetty, ginecólogo oncólogo y mastólogo en Cochabamba, Bolivia. Conoce sus servicios y solicita tu cita en línea."
  path="/"
>
  <!-- HERO -->
  <section class="on-dark relative isolate overflow-hidden bg-teal-900 text-teal-50">
    <Image
      src={logoLight}
      alt=""
      aria-hidden="true"
      width={900}
      class="pointer-events-none absolute -right-24 -top-16 -z-10 w-[34rem] max-w-none opacity-[0.07] md:-right-10"
      loading="eager"
    />
    <div class="container-page grid items-end gap-10 pb-0 pt-12 md:grid-cols-[1.15fr_0.85fr] md:pt-20">
      <div class="pb-12 md:pb-24">
        <p class="eyebrow !text-teal-300">Cochabamba, Bolivia</p>
        <h1 class="mt-4 text-[2.4rem] !leading-[1.05] !text-white sm:text-5xl lg:text-[3.6rem]">
          Dr. Rolando <span class="whitespace-nowrap">Vargas Calvetty</span>
        </h1>
        <p class="mt-4 font-display text-xl text-teal-200 sm:text-2xl">Ginecólogo Oncólogo · Mastólogo</p>
        <p class="mt-6 max-w-xl text-lg text-teal-100">
          Atención médica especializada en la salud de la mujer. Consulta los servicios del consultorio y solicita tu cita
          sin crear una cuenta.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`${base}/cita`} class="btn btn-light">
            <CalendarCheck aria-hidden="true" size={20} /> Solicitar cita
          </a>
          <a
            href={whatsappLink("Hola, quisiera consultar sobre una cita con el Dr. Vargas.")}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline text-white hover:bg-white/10"
          >
            <MessageCircle aria-hidden="true" size={20} /> Escribir por WhatsApp
          </a>
        </div>
        <p class="mt-4 text-sm text-teal-200">Tu solicitud queda pendiente hasta que el consultorio la confirme.</p>
      </div>

      <!-- FOTO PROVISIONAL: reemplazar por retrato profesional cuando exista (src/assets/doctor-provisional.jpg). -->
      <div class="mx-auto w-full max-w-sm md:max-w-none">
        <div class="hero-photo relative aspect-[9/10] w-full overflow-hidden rounded-t-[999px]">
          <Image
            src={doctorPhoto}
            alt="Retrato del Dr. Rolando Vargas Calvetty"
            width={640}
            class="h-full w-full object-cover object-[50%_20%]"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-funciona" class="scroll-mt-24 py-16 md:py-24">
    <div class="container-page">
      <p class="eyebrow">Solicitar una cita</p>
      <h2 class="mt-3 max-w-2xl text-3xl sm:text-4xl">Tres pasos, sin crear una cuenta</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="card p-6">
              <div class="flex items-center gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-teal-100 text-teal-800">
                  <s.icon aria-hidden="true" size={22} />
                </span>
                <span class="font-display text-lg text-teal-700" aria-hidden="true">
                  0{i + 1}
                </span>
              </div>
              <h3 class="mt-4 text-xl">{s.title}</h3>
              <p class="mt-2 text-ink-soft">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-8">
        <a href={`${base}/cita`} class="btn btn-primary">Comenzar solicitud</a>
      </div>
    </div>
  </section>

  <!-- ESPECIALIDADES -->
  <section id="especialidades" class="scroll-mt-24 bg-teal-50 py-16 md:py-24">
    <div class="container-page">
      <p class="eyebrow">Especialidades y servicios</p>
      <h2 class="mt-3 max-w-2xl text-3xl sm:text-4xl">Cuidado integral, desde el control hasta el tratamiento</h2>
      <p class="mt-4 max-w-2xl text-ink-soft">
        Esta información es orientativa y no reemplaza una evaluación médica individual. Para saber qué servicio
        necesitas, consulta con el consultorio.
      </p>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          SERVICE_GROUPS.map((g) => (
            <article class="card flex flex-col p-6 md:p-7" id={g.id}>
              <h3 class="text-2xl">{g.title}</h3>
              <p class="mt-2 text-ink-soft">{g.intro}</p>
              {g.items.length > 0 ? (
                <ul class="mt-5 space-y-3">
                  {g.items.map((item) => (
                    <li class="flex gap-3">
                      <Check aria-hidden="true" size={20} class="mt-0.5 shrink-0 text-teal-600" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="mt-5">
                  <p class="text-ink-soft">Consulta por WhatsApp para saber qué atención de mastología necesitas.</p>
                  <Pending label="Servicios de Mastología: el doctor debe proporcionarlos o validarlos." />
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- EL DOCTOR -->
  <section id="doctor" class="scroll-mt-24 py-16 md:py-24">
    <div class="container-page grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-start">
      <div>
        <p class="eyebrow">El doctor</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Rolando Vargas Calvetty</h2>
        <p class="mt-3 font-display text-xl text-teal-700">Ginecólogo Oncólogo · Mastólogo</p>
      </div>
      <div class="max-w-2xl">
        <p class="text-lg text-ink-soft">
          El Dr. Vargas atiende en su consultorio de Cochabamba, en el Edificio V&amp;V NUR, junto al Parque Fidel Anze.
        </p>
        <Pending label="Biografía, formación y trayectoria verificadas (universidades, años, sociedades médicas y el significado de «R.B.S.P.B. San Pablo · Brasil» de la tarjeta). No se publica nada hasta que el doctor lo confirme." />
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contacto" class="scroll-mt-24 bg-teal-900 py-16 text-teal-50 md:py-24 on-dark">
    <div class="container-page grid gap-10 md:grid-cols-2">
      <div>
        <p class="eyebrow !text-teal-300">Contacto y ubicación</p>
        <h2 class="mt-3 text-3xl !text-white sm:text-4xl">Visita el consultorio o escríbenos</h2>

        <ul class="mt-8 space-y-6">
          <li class="flex gap-4">
            <MapPin aria-hidden="true" class="mt-1 shrink-0 text-teal-300" />
            <address class="not-italic">
              <p class="font-semibold text-white">Dirección</p>
              <p class="text-teal-100">
                {CLINIC.address.line1}<br />
                {CLINIC.address.line2}, {CLINIC.address.floor.toLowerCase()}<br />
                {CLINIC.address.city}
              </p>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block font-semibold text-teal-200 underline underline-offset-4 hover:text-white">
                Abrir en Google Maps
              </a>
            </address>
          </li>
          <li class="flex gap-4">
            <Phone aria-hidden="true" class="mt-1 shrink-0 text-teal-300" />
            <div>
              <p class="font-semibold text-white">Teléfonos</p>
              <p class="text-teal-100">
                {CLINIC.phones.landlines.map((p, i) => (
                  <>
                    <a class="underline-offset-4 hover:underline" href={`tel:+591${p}`}>{p}</a>
                    {" · "}
                  </>
                ))}
                <a class="underline-offset-4 hover:underline" href={`tel:+${CLINIC.whatsappCountryCode}${CLINIC.phones.whatsapp}`}>{CLINIC.phones.whatsapp}</a>
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <Clock aria-hidden="true" class="mt-1 shrink-0 text-teal-300" />
            <div>
              <p class="font-semibold text-white">Horario de atención</p>
              <Pending label="Días y horarios de atención. Se mostrarán desde la agenda real una vez que el doctor los configure." />
            </div>
          </li>
        </ul>
      </div>

      <div class="rounded-[var(--radius-card)] bg-teal-800 p-7 md:p-9">
        <h3 class="text-2xl !text-white">¿Prefieres hablar por WhatsApp?</h3>
        <p class="mt-3 text-teal-100">
          Es el canal principal del consultorio. Al tocar el botón se abre WhatsApp con un mensaje sugerido; tú decides si
          lo envías.
        </p>
        <div class="mt-6 flex flex-col gap-3">
          <a
            href={whatsappLink("Hola, quisiera consultar sobre una cita con el Dr. Vargas.")}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp"
          >
            <MessageCircle aria-hidden="true" size={20} /> Abrir WhatsApp
          </a>
          <a href={`${base}/cita`} class="btn btn-light">Solicitar cita en línea</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Funde la foto con el fondo del hero: bordes y base suaves, sin cortes duros. */
  .hero-photo {
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
  }
</style>
