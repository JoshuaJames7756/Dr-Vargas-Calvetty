---
import Base from "../layouts/Base.astro";
import BookingFlow from "../modules/booking/BookingFlow.tsx";
---

<Base
  title="Solicitar cita"
  description="Solicita tu cita con el Dr. Rolando Vargas Calvetty en Cochabamba. Sin crear una cuenta: el consultorio revisa tu solicitud y te confirma."
  path="/cita"
>
  <section class="py-12 md:py-16">
    <div class="container-page">
      <div class="mx-auto mb-8 max-w-2xl">
        <p class="eyebrow">Solicitud de cita</p>
        <h1 class="mt-3 text-4xl">Solicita tu cita</h1>
        <p class="mt-3 text-ink-soft">
          No necesitas crear una cuenta. El consultorio revisará tu solicitud y te confirmará por WhatsApp. Hasta
          entonces, la cita no está confirmada.
        </p>
      </div>
      <BookingFlow client:load />
    </div>
  </section>
</Base>

<style is:global>
  .capitalize-first::first-letter {
    text-transform: uppercase;
  }
</style>
