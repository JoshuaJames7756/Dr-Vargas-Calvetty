---
import Base from "../layouts/Base.astro";
import BookingFlow from "../modules/booking/BookingFlow.tsx";
import WhatsAppRequest from "../components/WhatsAppRequest.astro";
import { COPY, LITE } from "../lib/mode";
---

<Base
  title="Solicitar cita"
  description={COPY.citaDescription}
  path="/cita"
>
  <section class="py-12 md:py-16">
    <div class="container-page">
      <div class="mx-auto mb-8 max-w-2xl">
        <p class="eyebrow">Solicitud de cita</p>
        <h1 class="mt-3 text-4xl">Solicita tu cita</h1>
        <p class="mt-3 text-ink-soft">
          {COPY.citaIntro}
        </p>
      </div>
      {LITE ? <WhatsAppRequest /> : <BookingFlow client:load />}
    </div>
  </section>
</Base>

<style is:global>
  .capitalize-first::first-letter {
    text-transform: uppercase;
  }
</style>
