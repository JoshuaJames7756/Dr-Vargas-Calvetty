---
import Base from "../layouts/Base.astro";
import { CLINIC } from "@dr-vargas/shared";
---

<Base title="Página no encontrada" description="La página que buscas no existe o cambió de dirección." path="/404" noindex>
  <section class="py-16 md:py-24">
    <div class="container-page max-w-2xl text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-4xl">No encontramos esta página</h1>
      <p class="mt-4 text-ink-soft">
        Puede que la dirección esté mal escrita o que la página haya cambiado de lugar. Desde aquí puedes volver al inicio, solicitar una cita o escribirnos por WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/">Ir al inicio</a>
        <a class="btn btn-outline" href="/cita">Solicitar cita</a>
        <a class="btn btn-outline" href="/contacto">Contacto</a>
      </div>
      <p class="mt-6 text-sm text-ink-soft">Teléfonos: {CLINIC.phones.landlines?.join(", ") ?? ""}</p>
    </div>
  </section>
</Base>
