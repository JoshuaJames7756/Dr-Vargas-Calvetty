---
import { CalendarCheck, Clock, ExternalLink, MapPin, MessageCircle, Navigation, Phone } from "lucide-react";
import { CLINIC, whatsappLink } from "@dr-vargas/shared";

interface Props {
  /** En la pagina de contacto el titulo es el h1 de la pagina. */
  asPage?: boolean;
}
const { asPage = false } = Astro.props;
const Heading = asPage ? "h1" : "h2";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { lat, lng, url: mapsUrl } = CLINIC.maps;
// Mapa incrustado sin clave de API, centrado en la ubicacion real. Si no carga, queda el boton "Como llegar".
const embedUrl = `https://www.google.com/maps?q=${lat},${lng}&z=17&output=embed&hl=es`;
const tile = "card card-lift flex flex-col justify-between p-6";
const chip = "flex h-11 w-11 items-center justify-center rounded-2xl";
---

<section id="contacto" class="bg-dots relative isolate scroll-mt-24 overflow-hidden bg-teal-50 py-14 md:py-20">
  <div class="blob -right-24 -top-10 h-80 w-80 bg-teal-300/40"></div>
  <div class="blob -left-24 bottom-0 h-72 w-72 bg-rose-100/70"></div>
  <div class="container-page">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Contacto y ubicación</p>
      <Heading class="mt-3 text-3xl sm:text-4xl">Encuéntranos o escríbenos</Heading>
      <p class="mt-3 text-ink-soft">Estamos en el Edificio V&amp;V NUR, frente al Parque Fidel Anze. Elige la forma que te quede más cómoda.</p>
    </div>

    <!-- MAPA con la ficha de llegada encima -->
    <div data-reveal style="--d: 80ms" class="relative mt-10 overflow-hidden rounded-[2rem] border border-line bg-white shadow-soft">
      <div class="relative h-72 bg-teal-100 sm:h-96 lg:h-[30rem]">
        <p class="absolute inset-0 flex items-center justify-center px-6 text-center text-sm text-teal-900">El mapa se está cargando. Si no aparece, usa el botón «Cómo llegar».</p>
        <iframe
          title="Mapa con la ubicación del consultorio"
          data-src={embedUrl}
          class="absolute inset-0 h-full w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
      <div class="p-6 sm:p-7 lg:absolute lg:left-6 lg:top-6 lg:w-[21rem] lg:rounded-3xl lg:bg-white lg:shadow-[0_20px_50px_-20px_rgb(10_63_66/0.45)] lg:ring-1 lg:ring-line">
        <address class="not-italic">
          <p class="flex items-center gap-2 font-display text-xl text-teal-900"><MapPin aria-hidden="true" size={20} class="text-teal-600" /> Consultorio</p>
          <p class="mt-2 text-ink-soft">
            {CLINIC.address.line1}<br />
            {CLINIC.address.line2}, {CLINIC.address.floor.toLowerCase()}<br />
            {CLINIC.address.city}
          </p>
        </address>
        <p class="mt-4 flex items-start gap-2 text-ink-soft"><Clock aria-hidden="true" size={18} class="mt-1 shrink-0 text-teal-600" /> {CLINIC.hours.label}</p>
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-5 w-full">
          <Navigation aria-hidden="true" size={18} /> Cómo llegar<span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
      </div>
    </div>

    <!-- FORMAS DE CONTACTO -->
    <ul class="mt-6 grid gap-5 md:grid-cols-3">
      <li data-reveal style="--d: 0ms">
        <div class={tile + " h-full"}>
          <span class={chip + " bg-teal-100 text-teal-800"}><Phone aria-hidden="true" size={22} /></span>
          <div><h3 class="mt-4 text-xl">Llámanos</h3>
          <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-lg">
            {CLINIC.phones.landlines.map((p) => <a class="font-semibold text-teal-800 underline-offset-4 hover:underline" href={`tel:+591${p}`}>{p}</a>)}
            <a class="font-semibold text-teal-800 underline-offset-4 hover:underline" href={`tel:+${CLINIC.whatsappCountryCode}${CLINIC.phones.whatsapp}`}>{CLINIC.phones.whatsapp}</a>
          </p>
          </div><p class="mt-5 text-sm text-ink-soft">{CLINIC.hours.label}</p>
        </div>
      </li>
      <li data-reveal style="--d: 90ms">
        <div class={tile + " h-full"}>
          <span class={chip + " bg-[#1f7a4d] text-white"}><MessageCircle aria-hidden="true" size={22} /></span>
          <h3 class="mt-4 text-xl">WhatsApp</h3>
          <p class="mt-2 text-ink-soft">Es el canal principal. Se abre con un mensaje sugerido; tú decides si lo envías.</p>
          <a href={whatsappLink("Hola, quisiera consultar sobre una cita con el Dr. Vargas.")} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp mt-6 w-full">
            Abrir WhatsApp
          </a>
        </div>
      </li>
      <li data-reveal style="--d: 180ms">
        <div class={tile + " h-full"}>
          <span class={chip + " bg-rose-100 text-rose-500"}><CalendarCheck aria-hidden="true" size={22} /></span>
          <h3 class="mt-4 text-xl">Solicita tu cita</h3>
          <p class="mt-2 text-ink-soft">Elige el servicio y un horario libre. El consultorio te confirma por WhatsApp.</p>
          <a href={`${base}/cita`} class="btn btn-outline mt-6 w-full !border-teal-700 !text-teal-800 hover:!bg-teal-50">Solicitar cita</a>
        </div>
      </li>
    </ul>

    {
      CLINIC.social.facebook && (
        <p data-reveal class="mt-8 text-center text-ink-soft">
          También en{" "}
          <a href={CLINIC.social.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold text-teal-800 underline underline-offset-4">
            Facebook <ExternalLink aria-hidden="true" size={14} /><span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        </p>
      )
    }
  </div>
</section>

<script>
  // El mapa de Google (y sus cookies) solo se carga cuando la persona se acerca a esa seccion.
  const map = document.querySelector<HTMLIFrameElement>("iframe[data-src]");
  if (map) {
    const load = () => {
      map.src = map.dataset.src!;
      map.removeAttribute("data-src");
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            load();
            io.disconnect();
          }
        },
        { rootMargin: "300px" },
      );
      io.observe(map);
    } else load();
  }
</script>
