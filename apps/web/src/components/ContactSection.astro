---
import { Clock, ExternalLink, MapPin, MessageCircle, Phone, CalendarCheck } from "lucide-react";
import { CLINIC, whatsappLink } from "@dr-vargas/shared";

interface Props {
  /** En la pagina de contacto el titulo es el h1 de la pagina. */
  asPage?: boolean;
}
const { asPage = false } = Astro.props;
const Heading = asPage ? "h1" : "h2";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const place = `${CLINIC.address.line1}, ${CLINIC.address.city}, Bolivia`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place)}`;
// Mapa incrustado sin clave de API. Si no carga, queda visible el enlace "Abrir en Google Maps".
const embedUrl = `https://www.google.com/maps?q=${encodeURIComponent(place)}&output=embed&hl=es`;
const item = "flex gap-4 rounded-2xl bg-teal-800/55 p-4 ring-1 ring-white/10 transition-colors hover:bg-teal-800/80";
const icon = "mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-700/70 text-teal-100";
---

<section id="contacto" class="on-dark relative isolate scroll-mt-24 overflow-hidden bg-teal-900 py-14 text-teal-50 md:py-20">
  <div class="pointer-events-none absolute -left-24 top-10 -z-10 h-72 w-72 rounded-full bg-teal-700/25 blur-3xl" aria-hidden="true"></div>
  <div class="container-page">
    <div data-reveal class="max-w-2xl">
      <p class="eyebrow !text-teal-300">Contacto y ubicación</p>
      <Heading class="mt-3 text-3xl !text-white sm:text-4xl">Visita el consultorio o escríbenos</Heading>
      <p class="mt-3 text-teal-100">Estamos en el Edificio V&amp;V NUR, frente al Parque Fidel Anze. Escríbenos por WhatsApp o pide tu cita en línea.</p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-stretch">
      <div class="flex flex-col gap-3" data-reveal style="--d: 80ms">
        <div class={item}>
          <span class={icon}><MapPin aria-hidden="true" size={20} /></span>
          <address class="not-italic">
            <p class="font-semibold text-white">Dirección</p>
            <p class="text-teal-100">
              {CLINIC.address.line1}<br />
              {CLINIC.address.line2}, {CLINIC.address.floor.toLowerCase()}<br />
              {CLINIC.address.city}
            </p>
          </address>
        </div>
        <div class={item}>
          <span class={icon}><Phone aria-hidden="true" size={20} /></span>
          <div>
            <p class="font-semibold text-white">Teléfonos</p>
            <p class="text-teal-100">
              {CLINIC.phones.landlines.map((p) => (
                <>
                  <a class="underline-offset-4 hover:underline" href={`tel:+591${p}`}>{p}</a>
                  {" · "}
                </>
              ))}
              <a class="underline-offset-4 hover:underline" href={`tel:+${CLINIC.whatsappCountryCode}${CLINIC.phones.whatsapp}`}>{CLINIC.phones.whatsapp}</a>
            </p>
          </div>
        </div>
        <div class={item}>
          <span class={icon}><Clock aria-hidden="true" size={20} /></span>
          <div>
            <p class="font-semibold text-white">Horario de atención</p>
            <p class="text-teal-100">{CLINIC.hours.label}</p>
          </div>
        </div>
        {
          CLINIC.social.facebook && (
            <div class={item}>
              <span class={icon}><ExternalLink aria-hidden="true" size={20} /></span>
              <div>
                <p class="font-semibold text-white">Facebook</p>
                <a href={CLINIC.social.facebook} target="_blank" rel="noopener noreferrer" class="text-teal-100 underline underline-offset-4 hover:text-white">
                  Página del consultorio<span class="sr-only"> (se abre en una pestaña nueva)</span>
                </a>
              </div>
            </div>
          )
        }
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <a href={whatsappLink("Hola, quisiera consultar sobre una cita con el Dr. Vargas.")} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp flex-1">
            <MessageCircle aria-hidden="true" size={20} /> Abrir WhatsApp
          </a>
          <a href={`${base}/cita`} class="btn btn-light flex-1"><CalendarCheck aria-hidden="true" size={20} /> Solicitar cita</a>
        </div>
        <p class="text-sm text-teal-200">WhatsApp se abre con un mensaje sugerido; tú decides si lo envías.</p>
      </div>

      <div data-reveal style="--d: 160ms" class="relative min-h-80 overflow-hidden rounded-[var(--radius-card)] bg-teal-800 ring-1 ring-white/15 lg:min-h-[28rem]">
        <p class="absolute inset-0 flex items-center justify-center px-6 text-center text-sm text-teal-100">El mapa se está cargando. Si no aparece, usa el botón «Abrir en Google Maps».</p>
        <iframe
          title="Mapa con la ubicación del consultorio"
          src={embedUrl}
          class="absolute inset-0 h-full w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute bottom-3 left-3 inline-flex min-h-11 items-center gap-2 rounded-full bg-white px-4 text-sm font-semibold text-teal-900 shadow-lg transition hover:bg-teal-50"
        >
          <MapPin aria-hidden="true" size={16} /> Abrir en Google Maps<span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
      </div>
    </div>
  </div>
</section>
