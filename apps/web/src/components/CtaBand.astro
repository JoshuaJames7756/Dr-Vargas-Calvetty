---
import { Image } from "astro:assets";
import { CalendarCheck, MessageCircle } from "lucide-react";
import { whatsappLink } from "@dr-vargas/shared";
import logoLight from "../assets/logo-light.png";

interface Props {
  title?: string;
  text?: string;
}
const { title = "¿Quieres pedir tu cita?", text = "Elige el servicio y un horario libre. El consultorio revisa tu solicitud y te confirma por WhatsApp." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="py-12 md:py-16">
  <div class="container-page">
    <div data-reveal class="on-dark relative isolate overflow-hidden rounded-[2rem] bg-gradient-to-br from-teal-900 to-teal-700 px-6 py-10 text-teal-50 sm:px-12 sm:py-14">
      <Image src={logoLight} alt="" aria-hidden="true" width={520} class="pointer-events-none absolute -right-10 -top-10 -z-10 w-72 max-w-none opacity-[0.09] sm:w-96" />
      <div class="max-w-xl">
        <h2 class="text-3xl !text-white sm:text-4xl">{title}</h2>
        <p class="mt-3 text-teal-100">{text}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href={`${base}/cita`} class="btn btn-light"><CalendarCheck aria-hidden="true" size={20} /> Solicitar cita</a>
          <a href={whatsappLink("Hola, quisiera consultar sobre una cita con el Dr. Vargas.")} target="_blank" rel="noopener noreferrer" class="btn btn-outline text-white hover:bg-white/10">
            <MessageCircle aria-hidden="true" size={20} /> Escribir por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
