---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { ChevronDown, Menu, X } from "lucide-react";
import { SERVICE_GROUPS } from "../data/services";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  {
    href: `${base}/servicios`,
    label: "Servicios",
    children: SERVICE_GROUPS.map((g) => ({ href: `${base}/servicios#${g.id}`, label: g.title })),
  },
  { href: `${base}/doctor`, label: "El doctor" },
  { href: `${base}/preguntas`, label: "Preguntas" },
  { href: `${base}/contacto`, label: "Contacto" },
];
const here = Astro.url.pathname.replace(/\/$/, "");
const cta = `${base}/cita`;
---

<header class="sticky top-0 z-40 border-b border-line bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/85">
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-4">
    <a href={`${base}/`} class="flex items-center gap-3" aria-label="Dr. Rolando Vargas Calvetty, inicio">
      <Image src={logo} alt="" width={56} height={36} class="h-9 w-auto" loading="eager" />
      <span class="leading-tight">
        <span class="block font-display text-[1.05rem] font-semibold text-teal-900">Dr. Rolando Vargas Calvetty</span>
        <span class="block text-xs tracking-wide text-ink-soft">Ginecólogo Oncólogo · Mastólogo</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-7 md:flex">
      {
        links.map((l) =>
          l.children ? (
            <div class="static" data-svc>
              <div class="flex items-center gap-1">
                <a href={l.href} aria-current={here === l.href ? "page" : undefined} class="text-[0.95rem] font-medium text-ink-soft hover:text-teal-700">
                  Servicios
                </a>
                <button
                  type="button"
                  data-svc-toggle
                  aria-expanded="false"
                  aria-controls="svc-panel"
                  aria-label="Mostrar especialidades"
                  class="group inline-flex h-8 w-8 items-center justify-center rounded-full text-ink-soft hover:bg-teal-100 hover:text-teal-800"
                >
                  <ChevronDown aria-hidden="true" size={16} class="transition-transform duration-200 group-aria-expanded:rotate-180 motion-reduce:transition-none" />
                </button>
              </div>
              <div
                id="svc-panel"
                data-svc-panel
                class="invisible absolute inset-x-0 top-full z-50 -translate-y-1.5 pt-2 opacity-0 transition duration-150 ease-out data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100 motion-reduce:transition-none"
              >
                <div class="container-page">
                  <div class="grid gap-8 rounded-3xl border border-line bg-white p-7 shadow-[0_24px_60px_-24px_rgb(10_63_66/0.35)] md:grid-cols-[1.4fr_1fr_1fr]">
                    {SERVICE_GROUPS.map((g) => (
                      <div>
                        <a href={`${base}/servicios#${g.id}`} class="font-display text-lg text-teal-900 hover:text-teal-700">{g.title}</a>
                        {g.items.length > 0 ? (
                          <ul class="mt-3 space-y-1.5">
                            {g.items.slice(0, 5).map((item) => (
                              <li>
                                <a href={`${base}/servicios#${g.id}`} class="text-sm text-ink-soft hover:text-teal-700">{item}</a>
                              </li>
                            ))}
                            {g.items.length > 5 && (
                              <li>
                                <a href={`${base}/servicios#${g.id}`} class="text-sm font-semibold text-teal-700">y {g.items.length - 5} más</a>
                              </li>
                            )}
                          </ul>
                        ) : (
                          <p class="mt-3 text-sm text-ink-soft">{g.intro}</p>
                        )}
                      </div>
                    ))}
                    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5 md:col-span-3">
                      <a href={`${base}/servicios`} class="font-semibold text-teal-700 underline underline-offset-4">Ver todos los servicios</a>
                      <a href={cta} class="btn btn-primary !min-h-11 !py-2">Solicitar cita</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ) : (
          <a
            href={l.href}
            class="text-[0.95rem] font-medium text-ink-soft hover:text-teal-700"
            aria-current={here === l.href ? "page" : undefined}
          >
            {l.label}
          </a>
          ),
        )
      }
      <a href={cta} class="btn btn-primary !min-h-11 !py-2">Solicitar cita</a>
    </nav>

    <div class="md:hidden" data-mnav>
      <button
        type="button"
        data-mnav-toggle
        aria-expanded="false"
        aria-controls="mnav-panel"
        aria-label="Abrir menú"
        class="group inline-flex h-12 w-12 items-center justify-center rounded-full text-teal-900 hover:bg-teal-100"
      >
        <Menu aria-hidden="true" size={26} class="group-aria-expanded:hidden" />
        <X aria-hidden="true" size={26} class="hidden group-aria-expanded:block" />
      </button>
      <nav
        id="mnav-panel"
        aria-label="Menú principal"
        class="invisible absolute inset-x-0 top-full -translate-y-2 border-b border-line bg-cream px-5 pb-6 pt-2 opacity-0 shadow-soft transition duration-200 ease-out data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100 motion-reduce:transition-none"
        data-mnav-panel
      >
        <ul class="flex flex-col">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="flex min-h-12 items-center border-b border-line text-lg font-medium text-ink">{l.label}</a>
                {l.children && (
                  <ul class="mb-2 ml-4 border-l-2 border-teal-100 pl-4">
                    {l.children.map((c) => (
                      <li>
                        <a href={c.href} class="flex min-h-11 items-center text-base text-ink-soft">{c.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <a href={cta} class="btn btn-primary mt-5 w-full">Solicitar cita</a>
      </nav>
    </div>
  </div>
</header>

<script>
  // Menus del encabezado sin framework: solo JavaScript nativo (ahorra cargar React en cada pagina).
  const setOpen = (root: HTMLElement, panel: HTMLElement, toggle: HTMLElement, open: boolean, labels?: [string, string]) => {
    panel.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    if (labels) toggle.setAttribute("aria-label", open ? labels[1] : labels[0]);
  };

  // Servicios (escritorio): el cursor lo abre, un clic lo deja fijo, Escape y salir del foco lo cierran.
  const svc = document.querySelector<HTMLElement>("[data-svc]");
  if (svc) {
    const toggle = svc.querySelector<HTMLElement>("[data-svc-toggle]")!;
    const panel = svc.querySelector<HTMLElement>("[data-svc-panel]")!;
    const labels: [string, string] = ["Mostrar especialidades", "Ocultar especialidades"];
    let pinned = false;
    let timer: number | undefined;
    const set = (open: boolean) => setOpen(svc, panel, toggle, open, labels);
    svc.addEventListener("mouseenter", () => {
      window.clearTimeout(timer);
      set(true);
    });
    svc.addEventListener("mouseleave", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (!pinned) set(false);
      }, 160);
    });
    toggle.addEventListener("click", () => {
      pinned = !pinned;
      set(pinned);
    });
    svc.addEventListener("focusout", (e) => {
      if (!svc.contains((e as FocusEvent).relatedTarget as Node | null)) {
        pinned = false;
        set(false);
      }
    });
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) {
        pinned = false;
        set(false);
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel.dataset.open === "true") {
        pinned = false;
        set(false);
        toggle.focus();
      }
    });
    document.addEventListener("mousedown", (e) => {
      if (!svc.contains(e.target as Node)) {
        pinned = false;
        set(false);
      }
    });
  }

  // Menu movil: boton con aria-expanded, Escape cierra y devuelve el foco al boton.
  const mnav = document.querySelector<HTMLElement>("[data-mnav]");
  if (mnav) {
    const toggle = mnav.querySelector<HTMLElement>("[data-mnav-toggle]")!;
    const panel = mnav.querySelector<HTMLElement>("[data-mnav-panel]")!;
    const labels: [string, string] = ["Abrir menú", "Cerrar menú"];
    const set = (open: boolean) => setOpen(mnav, panel, toggle, open, labels);
    toggle.addEventListener("click", () => set(panel.dataset.open !== "true"));
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) set(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel.dataset.open === "true") {
        set(false);
        toggle.focus();
      }
    });
  }
</script>
