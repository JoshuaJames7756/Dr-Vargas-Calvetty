---
/** Marcador de foto pendiente. Solo visible en modo demostracion; reemplazar por la imagen real. */
import { Camera } from "lucide-react";
import { SHOW_PENDING } from "../lib/pending";

interface Props {
  label: string;
  hint?: string;
  class?: string;
}
const { label, hint = "Foto pendiente", class: cls = "aspect-[4/3]" } = Astro.props;
---

{
  SHOW_PENDING && (
    <figure class={`flex w-full flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-teal-400 bg-teal-50 p-4 text-center ${cls}`}>
      <Camera aria-hidden="true" size={32} class="text-teal-600" />
      <figcaption>
        <span class="block font-semibold text-teal-900">{label}</span>
        <span class="block text-sm text-ink-soft">{hint}</span>
      </figcaption>
    </figure>
  )
}
