---
import { MessageCircle } from "lucide-react";
import { whatsappLink } from "@dr-vargas/shared";
import { SERVICE_GROUPS } from "../data/services";
import Pending from "./Pending.astro";
import Sample from "./Sample.astro";

/** Lista completa de servicios. Ginecologia va a todo el ancho (lista en columnas) y debajo Oncologia y Mastologia, sin huecos laterales. */
const [gineco, ...rest] = SERVICE_GROUPS;
---

<div class="grid gap-6">
  {
    gineco && (
      <article class="card scroll-mt-28 p-6 md:p-8" id={gineco.id} data-reveal>
        <h3 class="text-2xl">{gineco.title}</h3>
        <p class="mt-2 text-ink-soft">{gineco.intro}</p>
        <ul class="mt-6 flex flex-wrap gap-2.5">
          {gineco.items.map((item) => (
            <li class="rounded-full border border-teal-200 bg-teal-50/70 px-4 py-2 text-[0.95rem] leading-snug text-teal-900 transition duration-200 hover:-translate-y-0.5 hover:border-teal-400 hover:bg-white hover:shadow-soft motion-reduce:transition-none motion-reduce:hover:translate-y-0">{item}</li>
          ))}
        </ul>
      </article>
    )
  }
  <div class="grid items-stretch gap-6 md:grid-cols-2">
    {
      rest.map((g, i) => (
        <article class="card scroll-mt-28 p-6 md:p-8" id={g.id} data-reveal style={`--d: ${(i + 1) * 90}ms`}>
          <h3 class="text-2xl">{g.title}</h3>
          <p class="mt-2 text-ink-soft">{g.intro}</p>
          {g.items.length > 0 ? (
            <ul class="mt-6 flex flex-wrap gap-2.5">
              {g.items.map((item) => (
                <li class="rounded-full border border-teal-200 bg-teal-50/70 px-4 py-2 text-[0.95rem] leading-snug text-teal-900 transition duration-200 hover:-translate-y-0.5 hover:border-teal-400 hover:bg-white hover:shadow-soft motion-reduce:transition-none motion-reduce:hover:translate-y-0">{item}</li>
              ))}
            </ul>
          ) : (
            <div class="mt-6 rounded-2xl bg-teal-50 p-5">
              <p class="text-teal-900">Consulta por WhatsApp para saber qué atención de mastología necesitas.</p>
              <a href={whatsappLink("Hola, quisiera consultar sobre atención de mastología con el Dr. Vargas.")} target="_blank" rel="noopener noreferrer" class="btn btn-outline mt-4 !border-teal-700 !bg-white !text-teal-800 hover:!bg-teal-100">
                <MessageCircle aria-hidden="true" size={18} /> Consultar por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
              <Sample label="Servicios de ejemplo. El doctor indica cuáles ofrece.">
                <ul class="space-y-2 text-ink">
                  <li>[Servicio de mastología 1]</li>
                  <li>[Servicio de mastología 2]</li>
                  <li>[Servicio de mastología 3]</li>
                </ul>
              </Sample>
              <Pending label="Servicios de Mastología: el doctor debe proporcionarlos o validarlos." />
            </div>
          )}
        </article>
      ))
    }
  </div>
</div>
